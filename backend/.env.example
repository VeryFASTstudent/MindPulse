# --- MongoDB ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=mindpulse

# --- App ---
APP_NAME=MindPulse API
ENVIRONMENT=development
DEBUG=true

# --- Auth (used starting Phase 2, defined now so config is centralized) ---
JWT_SECRET=change_this_to_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Chat AI ---
CHAT_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_CHAT_MODEL=gemini-2.5-flash
DELIVERY_MODE=outbox_only
UNIVERSITY_PSYCHOLOGIST_EMAIL=psychologist@gmail.com
# To use OpenAI instead, set CHAT_PROVIDER=openai and configure OPENAI_API_KEY.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_CHAT_MODEL=gpt-4o-mini

# --- Sentiment analysis (Phase 6) ---
SENTIMENT_ENABLED=true
SENTIMENT_MODEL_NAME=j-hartmann/emotion-english-distilroberta-base
